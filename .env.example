# Only what the app needs before it starts. Everything else (model, API key,
# limits, mail, site address, fixed admin code) is set in the app:
# gear icon → settings (admins only). Values below are just fallbacks.

# The first administrator. Only this address can sign in while the app has no users.
ADMIN_EMAIL=you@example.com

# Public address of the site (also editable in the app → «Сайт»)
BASE_URL=https://diary.example.com

# Temporary fixed 6-digit sign-in code for ADMIN_EMAIL, until mail works
# (also editable in the app → «Вход»). Remove afterwards.
STATIC_LOGIN_CODE=

PORT=3000
