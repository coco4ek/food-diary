# Public address of the app, exactly as people open it (used in invite links)
BASE_URL=https://kkal.example.com

# Any OpenAI-compatible Chat Completions API that accepts images
# OpenRouter:  https://openrouter.ai/api/v1
# OpenAI:      https://api.openai.com/v1
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Model must support image input. Examples: anthropic/claude-sonnet-4.5, google/gemini-2.5-flash, openai/gpt-4o-mini
LLM_MODEL=anthropic/claude-sonnet-4.5

# Photo recognitions per person per day (protects your API budget)
DAILY_LIMIT=40

PORT=3000
