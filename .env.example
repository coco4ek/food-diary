# Public address of the app, exactly as people open it (used in invites and letters)
BASE_URL=https://kkal.example.com

# The first administrator. Only this address can sign in while the app has no users.
ADMIN_EMAIL=you@example.com

# Mail for sign-in codes and invites. Without SMTP_HOST, letters are printed to the log.
# Yandex: smtp.yandex.ru, 465 (app password) · Mail.ru: smtp.mail.ru, 465 · Gmail: smtp.gmail.com, 465 (app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Дневник калорий <robot@example.com>"; defaults to SMTP_USER
SMTP_FROM=

# Any OpenAI-compatible Chat Completions API that accepts images.
# Default: GLM from z.ai (key: https://z.ai/manage-apikey/apikey-list)
#   z.ai:        https://api.z.ai/api/paas/v4
#   z.ai China:  https://open.bigmodel.cn/api/paas/v4
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      https://api.openai.com/v1
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_API_KEY=
# Must accept images. z.ai: glm-4.6v (default), glm-4.6v-flashx (cheaper), glm-4.6v-flash (free), glm-5v-turbo (newest)
LLM_MODEL=glm-4.6v
# Optional provider-specific fields (JSON). GLM thinking makes answers slower but usually more careful:
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY=

# Photo recognitions per person per day (protects your API budget)
DAILY_LIMIT=40

PORT=3000
