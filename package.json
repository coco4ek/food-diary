  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "10.1.6",
    "better-sqlite3": "11.8.1",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "nodemailer": "10.0.10",
    "undici": "6.28.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.13.1",
    "@types/nodemailer": "8.0.2",
    "typescript": "5.7.3"
  }
}
