{
  "name": "kkal-dnevnik",
  "version": "1.0.0",
  "private": true,
  "description": "Дневник калорий по фото — self-hosted PWA",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node --env-file=.env dist/server.js",
